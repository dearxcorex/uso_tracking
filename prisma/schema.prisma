generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One planned site visit from the USO Net phase 2 department Word files (data/*.docx)
model visit_plan {
  id               Int       @id @default(autoincrement())
  round            String
  department       String
  dept_seq         Int?
  service_type     String?
  service_name     String
  village_code     String?
  village          String?
  subdistrict      String?
  district         String?
  province         String?
  install_location String?
  provider         String?
  latitude         Float?
  longitude        Float?
  project          String?
  phone            String?
  phone_source     String?
  inspected        Boolean   @default(false)
  inspected_at     DateTime?
  created_at       DateTime  @default(now())

  @@unique([round, department, service_name, village_code])
  @@index([department])
  @@index([round])
  @@index([district])
}
